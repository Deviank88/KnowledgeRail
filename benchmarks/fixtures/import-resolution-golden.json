      },
      "edges": [["odd/use.py", "odd/orders.py"]],
      "issues": [["odd/use.py", "orders", "ambiguous"], ["odd/use.py", "external_vendor", "unresolved"]]
    },
    {
      "id": "javascript-relative-ambiguity-and-explicit-extension",
      "files": {
        "unit.ts": "export const value = 1;",
        "unit.tsx": "export const value = 2;",
        "use.ts": "import './unit'; import './unit.ts'; import 'node:fs';"
      },
      "edges": [["use.ts", "unit.ts"]],
      "issues": [["use.ts", "./unit", "ambiguous"], ["use.ts", "node:fs", "unresolved"]]
    },
    {
      "id": "javascript-manifest-ties-and-ordered-fallback",
      "files": {
        "tsconfig.json": "{\"compilerOptions\":{\"paths\":{\"@tie/*\":[\"./one.ts\"],\"@tie/*end\":[\"./two.ts\"],\"@fallback\":[\"./missing\",\"./one.ts\"],\"@blocked\":[\"./amb\",\"./two.ts\"]}}}",
        "one.ts": "export const value = 1;",
        "two.ts": "export const value = 2;",
        "amb.ts": "export const value = 3;",
        "amb.tsx": "export const value = 4;",
        "use.ts": "import '@tie/Thingend'; import '@fallback'; import '@blocked';"
      },
      "edges": [["use.ts", "one.ts"]],
      "issues": [["use.ts", "@tie/*, @tie/*end", "ambiguous"], ["use.ts", "@blocked", "ambiguous"]]
    },
    {
