{
  "version": 1,
  "scope": "Hand-authored source/manifest fixtures with explicit import-edge oracles; not a population-wide language benchmark.",
  "cases": [
    {
      "id": "kotlin-alias-duplicate-declarations",
      "files": {
        "one/Misc.kt": "package acme\nclass Order {}",
        "two/Other.kt": "package acme\nclass Order {}",
        "unique/Unrelated.kt": "package acme\nfun place() {}",
        "use.kt": "import acme.Order as Invoice\nimport acme.place\nfun run() {}"
      },
      "edges": [["use.kt", "unique/Unrelated.kt"]],
      "issues": [["use.kt", "acme.Order", "ambiguous"]]
    },
    {
      "id": "lwc-virtual-import-duplicate-apex-method",
      "files": {
        "one/Orders.cls": "public class Orders {\n @AuraEnabled\n public static void load() {}\n}",
        "two/Orders.cls": "public class Orders {\n @AuraEnabled\n public static void load() {}\n}",
        "odd/Billing.cls": "public class Billing {\n @AuraEnabled\n public static void save() {}\n}",
        "use.js": "import load from '@salesforce/apex/Orders.load';\nimport save from '@salesforce/apex/Billing.save';"
      },
      "edges": [["use.js", "odd/Billing.cls"]],
      "issues": [["use.js", "@salesforce/apex/Orders.load", "ambiguous"]]
    },
    {
      "id": "java-declared-group-and-duplicate-type",
      "files": {
        "odd/One.java": "package acme;\npublic class One {}",
        "a/Dup.java": "package acme;\npublic class Dup {}",
        "b/Dup.java": "package acme;\npublic class Dup {}",
        "Group.java": "import acme.*;\npublic class Group {}",
        "Single.java": "import acme.Dup;\npublic class Single {}"
      },
      "edges": [["Group.java", "odd/One.java"], ["Group.java", "a/Dup.java"], ["Group.java", "b/Dup.java"]],
      "issues": [["Single.java", "acme.Dup", "ambiguous"]]
    },
    {
      "id": "csharp-namespace-and-ambiguous-alias",
      "files": {
        "odd/A.cs": "namespace Acme;\npublic class A {}",
        "odd/B.cs": "namespace Acme;\npublic class B {}",
        "a/Dup.cs": "namespace Other;\npublic class Dup {}",
        "b/Dup.cs": "namespace Other;\npublic class Dup {}",
        "Consumer.cs": "using Acme;\nusing Alias = Other.Dup;\npublic class Consumer {}"
      },
      "edges": [["Consumer.cs", "odd/A.cs"], ["Consumer.cs", "odd/B.cs"]],
      "issues": [["Consumer.cs", "Other.Dup", "ambiguous"]]
    },
    {
      "id": "php-partial-group-keeps-valid-member",
      "files": {
        "A.php": "<?php\nnamespace Acme;\nclass A {}",
        "a/Dup.php": "<?php\nnamespace Acme;\nclass Dup {}",
        "b/Dup.php": "<?php\nnamespace Acme;\nclass Dup {}",
        "Consumer.php": "<?php\nuse Acme\\{A, Dup, Missing};\nclass Consumer {}"
      },
      "edges": [["Consumer.php", "A.php"]],
      "issues": [["Consumer.php", "Acme\\Dup", "ambiguous"], ["Consumer.php", "Acme\\Missing", "unresolved"]]
    },
    {
      "id": "python-root-conflict-and-relative",
      "files": {
        "orders.py": "value = 1\n",
        "odd/orders.py": "value = 2\n",
